        "alarm_generic",
        "alarm_tamper"
      ],
      "capabilitiesOptions": {
        "alarm_generic": {
          "title": {
            "en": "Smart event",
            "nl": "Slimme gebeurtenis",
            "pl": "Zdarzenie inteligentne"
          }
        }
      },
      "platforms": [
