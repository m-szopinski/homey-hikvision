{
  "extends": "athom/homey-app",
  "settings": {
    "import/resolver": {
      "node": {
        "extensions": [".js", ".ts"]
      }
    }
  },
  "rules": {
    "import/extensions": ["error", "ignorePackages", { "js": "never", "ts": "never" }],
    "import/prefer-default-export": "off",
    "node/no-missing-import": ["error", { "tryExtensions": [".js", ".ts", ".json"], "allowModules": ["homey"] }],
    "camelcase": ["error", { "properties": "never", "allow": ["use_https", "event_type", "alarm_auto_reset"] }]
  }
}
